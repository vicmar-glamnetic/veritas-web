# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------
# The POOLED connection string. `neon link` writes this automatically; the pooled
# host is the one ending in "-pooler". Use the pooled URL for the app, because
# serverless functions open and drop connections constantly.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection, also written by `neon link`. Not used by the app.
DATABASE_URL_UNPOOLED=""

# An EMPTY database used by `npm test`. It must have migrations applied and must
# never be seeded: seeded sessions would show up in availability results, because
# laboratory and imaging sessions are not tied to a doctor.
#   neon databases create --name veritas_test --branch main
#   DATABASE_URL=<that database> npx drizzle-kit migrate
TEST_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Verified sender. Until the clinic's domain is verified, onboarding@resend.dev works.
RESEND_FROM="Veritas Clinic <onboarding@resend.dev>"
# Where the /contact inquiry form is delivered.
CLINIC_INBOX="frontdesk@example.com"

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# 32+ random bytes, base64. Signs the staff session cookie.
#   openssl rand -base64 32
SESSION_SECRET=""

# Used only by `npm run db:seed` to create the first admin login.
ADMIN_SEED_EMAIL="admin@veritasclinic.ph"
ADMIN_SEED_PASSWORD="change-me-before-the-demo"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, used for canonical URLs, Open Graph tags and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
